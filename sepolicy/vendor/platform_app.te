hal_client_domain(platform_app, hal_mtk_bgs)
hal_client_domain(platform_app_36, hal_mtk_bgs)

allow { platform_app platform_app_36 } vendor_camera_data_file:dir { append map r_dir_perms write };
allow { platform_app platform_app_36 } vendor_camera_data_file:file { getattr open read };

allow { platform_app platform_app_36 } apusys_device:chr_file rw_file_perms;

allow { platform_app platform_app_36 } app_data_file:file execute;

allow { platform_app platform_app_36 } proc_stat:file r_file_perms;

binder_call(mtk_hal_camera, platform_app)
binder_call(mtk_hal_camera, platform_app_36)

# Properties
get_prop(platform_app, vendor_mtk_camera_prop)
get_prop(platform_app_36, vendor_mtk_camera_prop)
